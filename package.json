{
  "name": "van-nav-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "van-nav 轻量导航站 — Cloudflare Worker 版（React 静态前端 + Worker + D1 + Zero Trust）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "d1:list": "wrangler d1 list",
    "d1:init": "wrangler d1 execute van-nav-db --remote --file=./schema.sql -y"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
